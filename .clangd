If:
  PathMatch: .*\.(cpp|cc|cxx|hpp|hh|hxx|h)$
CompileFlags:
  Add:
    - -std=c++20

---
If:
  PathMatch: .*\.c$
CompileFlags:
  Add:
    - -std=c17

---
If:
  PathMatch: .*\.mm$
CompileFlags:
  Add:
    - -std=c++20
    - -xobjective-c++
