# Windows command scripts
*.cmd text eol=crlf

# Generated files
*.generated.cpp linguist-generated -diff
/.github/workflows/*.lock.yml linguist-generated
/docs/download-trends.svg linguist-generated
/docs/star-history.svg linguist-generated

# Vendored source and license texts
/vendor/cpp-httplib/** linguist-vendored
/vendor/cpp-httplib/httplib.h -text
/vendor/cpp-httplib/LICENSE -text
/vendor/Simd/LICENSE -text
/vendor/Simd/src/** linguist-vendored

# Prebuilt SDK files
*.lib binary linguist-generated
*.tbd linguist-generated
