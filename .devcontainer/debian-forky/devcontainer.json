{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "Debian Forky",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "containerEnv": {
    "PLUGIN_BUILD_DIR": "/home/vscode/obs-backgroundremoval-build",
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8"
  },
  "forwardPorts": [5901],
  "portsAttributes": {
    "5901": {
      "label": "VNC",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "editorconfig.editorconfig",
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools",
        "openai.chatgpt",
        "stevejpurves.cucumber"
      ],
      "settings": {
        "cmake.buildDirectory": "/home/vscode/obs-backgroundremoval-build/build",
        "cmake.configureSettings": {
          "CMAKE_BUILD_TYPE": "RelWithDebInfo"
        },
        "clangd.arguments": [
          "--compile-commands-dir=/home/vscode/obs-backgroundremoval-build/build"
        ]
      }
    }
  },
  "postCreateCommand": "git submodule update --init --filter=blob:none vendor/ncnn",
  "postStartCommand": {
    "start-vnc": ".devcontainer/debian-forky/start-vnc.sh",
    "fix-codex-permissions": "sudo chown -R vscode:vscode /home/vscode/.codex"
  },
  "mounts": [
    "source=codex-auth,target=/home/vscode/.codex,type=volume"
  ],
  "securityOpt": ["seccomp=unconfined"]
}
