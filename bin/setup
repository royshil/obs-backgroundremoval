# SPDX-License-Identifier: Apache-2.0

macos() {
  : "${PLUGIN_BUILD_DIR:=$PWD}"
  : "${PYTHON:=$(brew --prefix python)/bin/python3}"
  export PLUGIN_BUILD_DIR PYTHON

  printf '#==> Load buildspec.props\n'

  local vcpkg_default_git_tag vcpkg_default_git_commit obs_studio_git_tag obs_studio_git_commit onnxruntime_git_tag onnxruntime_git_commit
  eval "$(awk '/^(vcpkg_default|obs_studio|onnxruntime)_git_(tag|commit)=/{print}' buildspec.props)"

  printf '#==> Ensure vcpkg and its toolchains\n'

  if [[ -z "${VCPKG_ROOT:-}" ]]; then
    export VCPKG_ROOT="${PLUGIN_BUILD_DIR:-.}/vcpkg"

    if ! [[ -d "$VCPKG_ROOT" ]]; then
      git clone --filter blob:none --branch "$vcpkg_default_git_tag" https://github.com/microsoft/vcpkg.git "$VCPKG_ROOT"
    fi

    if ! git -C "$VCPKG_ROOT" rev-parse HEAD | grep -q "$vcpkg_default_git_commit"; then
      printf 'ERROR: vcpkg commit hash mismatch.\n'; exit 1
    fi

    if ! [[ -e "$VCPKG_ROOT/vcpkg" ]]; then
      "$VCPKG_ROOT/bootstrap-vcpkg.sh"
    fi
  fi

  local pwshExe
  pwshExe=$("$VCPKG_ROOT/vcpkg" fetch powershell-core | tail -n1)

  if ! [[ -e "$pwshExe" ]]; then
    printf 'ERROR: pwsh not found.\n'; exit 1
  fi

  PATH="${pwshExe%/*}:$PATH"
  export PATH

  printf '#==> Set up OBS sources and dependencies\n'

  if ! [[ -d "${PLUGIN_BUILD_DIR:-.}/obs-studio" ]]; then
    git clone --filter blob:none --branch "$obs_studio_git_tag" https://github.com/obsproject/obs-studio.git "${PLUGIN_BUILD_DIR:-.}/obs-studio"
  fi

  git -C "${PLUGIN_BUILD_DIR:-.}/obs-studio" fetch origin "$obs_studio_git_tag"
  git -C "${PLUGIN_BUILD_DIR:-.}/obs-studio" checkout --force FETCH_HEAD
  git -C "${PLUGIN_BUILD_DIR:-.}/obs-studio" clean -fdx
  git -C "${PLUGIN_BUILD_DIR:-.}/obs-studio" submodule update --init --recursive --filter=blob:none

  if ! git -C "${PLUGIN_BUILD_DIR:-.}/obs-studio" rev-parse HEAD | grep -q "$obs_studio_git_commit"; then
    printf 'ERROR: obs-studio commit hash mismatch.\n'; exit 1
  fi

  if ! [[ -d "${PLUGIN_BUILD_DIR:-.}/.deps/obs-deps" ]]; then
    pwsh -NoProfile -Command 'Import-Module ./scripts/BuildOBS.psm1; Initialize-ObsDeps -Component prebuilt'
  fi

  if ! [[ -d "${PLUGIN_BUILD_DIR:-.}/.deps/obs-deps-qt6" ]]; then
    pwsh -NoProfile -Command 'Import-Module ./scripts/BuildOBS.psm1; Initialize-ObsDeps -Component qt6'
  fi

  printf '#==> Set up ONNX Runtime source\n'

  if ! [[ -d "${PLUGIN_BUILD_DIR:-.}/onnxruntime" ]]; then
    git clone --filter blob:none --branch "$onnxruntime_git_tag" https://github.com/microsoft/onnxruntime.git "${PLUGIN_BUILD_DIR:-.}/onnxruntime"
  fi

  git -C "${PLUGIN_BUILD_DIR:-.}/onnxruntime" fetch origin "$onnxruntime_git_tag"
  git -C "${PLUGIN_BUILD_DIR:-.}/onnxruntime" checkout --force FETCH_HEAD
  git -C "${PLUGIN_BUILD_DIR:-.}/onnxruntime" clean -fdx
  git -C "${PLUGIN_BUILD_DIR:-.}/onnxruntime" submodule update --init --recursive --filter=blob:none

  if ! git -C "${PLUGIN_BUILD_DIR:-.}/onnxruntime" rev-parse HEAD | grep -q "$onnxruntime_git_commit"; then
    printf 'ERROR: onnxruntime commit hash mismatch.\n'; exit 1
  fi

  pwsh -NoProfile -Command 'Import-Module ./scripts/BuildOnnxRuntime.psm1; Update-OrtSourceWithPatches'

  printf '#==> Set up python\n'

  if ! [[ -d "${PLUGIN_BUILD_DIR:-.}/.venv" ]]; then
    "$PYTHON" -m venv "${PLUGIN_BUILD_DIR:-.}/.venv"
  fi

  "${PLUGIN_BUILD_DIR:-.}/.venv/bin/pip3" install -r requirements-build.txt
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  set -euo pipefail
  shopt -s nullglob

  if ! [[ -f buildspec.props ]]; then
    printf 'ERROR: buildspec.props not found. The working directory MUST be the root of the project.\n' >&2
    exit 1
  fi

  if [[ "$(uname -s)" == Darwin ]]; then
    macos
  fi
fi
