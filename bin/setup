macos() {
  : "${PLUGIN_BUILD_DIR:=${PWD:?}}"

  : "${VCPKG_ROOT:=${PLUGIN_BUILD_DIR:?}/vendor/vcpkg}"

  local vcpkg_git_tag obs_studio_git_tag onnxruntime_git_tag
  eval "$(awk '/^(vcpkg|obs_studio|onnxruntime)_git_tag=/ { print }' buildspec.props)"

  local prebuilt_macos_url prebuilt_macos_sha256 qt6_macos_url qt6_macos_sha256
  eval "$(awk '/^(prebuilt|qt6)_macos_(url|sha256)=/ { print }' buildspec.props)"

  local ccache_macos_version ccache_macos_url ccache_macos_sha256
  eval "$(awk '/^ccache_macos_(version|url|sha256)=/ { print }' buildspec.props)"
  printf 'INFO: buildspec.props was loaded\n' >&2

  JOB_TEMP="$(mktemp -d -t "obs-backgroundremoval-setup.XXXXXXX")"
  export JOB_TEMP
  mkdir -p "${JOB_TEMP:?}"

  if ! [[ -e "${VCPKG_ROOT:?}/vcpkg" ]]; then
    "${VCPKG_ROOT:?}/bootstrap-vcpkg.sh" -disableMetrics
    printf 'INFO: vcpkg was bootstrapped\n' >&2
  fi

  if [[ -e "${PLUGIN_BUILD_DIR:-${PWD:?}}/.deps/ccache/ccache-${ccache_macos_version:?}-darwin/ccache" ]]; then
    printf 'INFO: ccache already exists\n' >&2
  else
    env \
      URL="${ccache_macos_url:?}" \
      SHA256="${ccache_macos_sha256:?}" \
      DESTDIR="${PLUGIN_BUILD_DIR:-${PWD:?}}/.deps/ccache" \
      cmake -P scripts/download-deps.cmake
    chmod 755 "${PLUGIN_BUILD_DIR:-${PWD:?}}/.deps/ccache/ccache-${ccache_macos_version:?}-darwin/ccache"
    printf 'INFO: ccache was installed at %q\n' "${PLUGIN_BUILD_DIR:-${PWD:?}}/.deps/ccache/ccache-${ccache_macos_version:?}-darwin/ccache" >&2
  fi

  if [[ -f "${PLUGIN_BUILD_DIR:-${PWD:?}}/.deps/obs-deps/.ok" ]]; then
    printf 'INFO: obs-deps already exists\n' >&2
  else
    env \
      URL="${prebuilt_macos_url:?}" \
      SHA256="${prebuilt_macos_sha256:?}" \
      DESTDIR="${PLUGIN_BUILD_DIR:-${PWD:?}}/.deps/obs-deps" \
      cmake -P scripts/download-deps.cmake
    touch "${PLUGIN_BUILD_DIR:-${PWD:?}}/.deps/obs-deps/.ok"
    printf 'INFO: obs-deps was installed at %q\n' "${PLUGIN_BUILD_DIR:-${PWD:?}}/.deps/obs-deps" >&2
  fi

  if [[ -f "${PLUGIN_BUILD_DIR:-${PWD:?}}/.deps/obs-deps-qt6/.ok" ]]; then
    printf 'INFO: obs-deps-qt6 already exists\n' >&2
  else
    env \
      URL="${qt6_macos_url:?}" \
      SHA256="${qt6_macos_sha256:?}" \
      DESTDIR="${PLUGIN_BUILD_DIR:-${PWD:?}}/.deps/obs-deps-qt6" \
      cmake -P scripts/download-deps.cmake
    touch "${PLUGIN_BUILD_DIR:-${PWD:?}}/.deps/obs-deps-qt6/.ok"
    printf 'INFO: obs-deps-qt6 was installed at %q\n' "${PLUGIN_BUILD_DIR:-${PWD:?}}/.deps/obs-deps-qt6" >&2
  fi

  if ! [[ -d "${PLUGIN_BUILD_DIR:-${PWD:?}}/.venv" ]]; then
    "$(brew --prefix python)/bin/python3" -m venv "${PLUGIN_BUILD_DIR:-${PWD:?}}/.venv"
    printf 'INFO: .venv was created\n' >&2
  fi

  "${PLUGIN_BUILD_DIR:-${PWD:?}}/.venv/bin/python3" -m pip install -r requirements-build.txt
  printf 'INFO: packages in .venv were updated\n' >&2
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  set -euo pipefail
  shopt -s nullglob

  if ! [[ -f buildspec.props ]]; then
    printf 'ERROR: buildspec.props not found. The working directory MUST be the root of the project.\n' >&2
    exit 1
  fi

  if [[ "$(uname -s)" == Darwin ]]; then
    macos
  fi
fi
