#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Kaito Udagawa <umireon@kaito.tokyo>
#
# SPDX-License-Identifier: Apache-2.0

if command -v pipx >/dev/null 2>&1; then
  run_gersemi() {
    pipx run --python 3.14 'gersemi==0.29.2' "$@"
  }
  run_reuse() {
    pipx run --python 3.14 'reuse[charset-normalizer]==6.3.0' "$@"
  }
  run_clang_format() {
    pipx run --python 3.14 'clang-format==21.1.8' "$@"
  }
elif command -v py >/dev/null 2>&1; then
  run_gersemi() {
    py -m pipx run --python 3.14 'gersemi==0.29.2' "$@"
  }
  run_reuse() {
    py -m pipx run --python 3.14 'reuse[charset-normalizer]==6.3.0' "$@"
  }
  run_clang_format() {
    py -m pipx run --python 3.14 'clang-format==21.1.8' "$@"
  }
else
  if command -v gersemi >/dev/null 2>&1; then
    run_gersemi() {
      gersemi "$@"
    }
  else
    run_gersemi() {
      printf 'Warning: gersemi not found; skipping\n' >&2
    }
  fi

  if command -v reuse >/dev/null 2>&1; then
    run_reuse() {
      reuse "$@"
    }
  else
    run_reuse() {
      printf 'Warning: reuse not found; skipping\n' >&2
    }
  fi

  if command -v clang-format >/dev/null 2>&1; then
    run_clang_format() {
      clang-format "$@"
    }
  elif command -v xcrun >/dev/null 2>&1; then
    run_clang_format() {
      xcrun clang-format "$@"
    }
  else
    run_clang_format() {
      printf 'Warning: clang-format not found; skipping\n' >&2
    }
  fi
fi

cmake_files=$(git ls-files ':/CMakeLists.txt' ':/cmake/*.cmake' ':/src/*CMakeLists.txt' ':/tests/*CMakeLists.txt' 2>/dev/null)
sources=$(git ls-files :/{src,tests}'/*.'{cpp,hpp,c,h,m,mm} 2>/dev/null)

# Without files, the tools would wait for standard input.
if [ -z "$cmake_files" ]; then
  run_gersemi() {
    printf 'Warning: no CMake files found; skipping\n' >&2
  }
fi
if [ -z "$sources" ]; then
  run_clang_format() {
    printf 'Warning: no source files found; skipping\n' >&2
  }
fi

case "${1:-check}" in
check)
  run_reuse lint && \
  run_gersemi $cmake_files --check && \
  run_clang_format $sources --dry-run --Werror
  ;;
fix)
  run_gersemi $cmake_files -i && \
  run_clang_format $sources -i
  ;;
*)
  printf 'Usage: %s [check|fix]\n' "${0##*/}" >&2
  exit 2
  ;;
esac
