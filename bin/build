set -euo pipefail
shopt -s nullglob

debian_forky() {
  cmake -B "${PLUGIN_BUILD_DIR:-.}/build" --preset linux
  cmake --build "${PLUGIN_BUILD_DIR:-.}/build" --preset linux
  (cd "${PLUGIN_BUILD_DIR:-.}/build" && cpack -G DEB)
}

ubuntu_resolute() {
  cmake -G Ninja -S "$ROOT_DIR" -B "${PLUGIN_BUILD_DIR:-.}/build"

  cmake --build "${PLUGIN_BUILD_DIR:-.}/build"

  (cd "${PLUGIN_BUILD_DIR:-.}/build" && cpack -G DEB)

  . "${PLUGIN_BUILD_DIR:-.}/build/cmake_export.sh"

  printf 'Run the following command to install the plugin:\n'
  printf '  sudo dpkg -i %s\n' "$ROOT_DIR/release/${PLUGIN_NAME}_*.deb"
}

arch() {
  cmake -G Ninja -S "$ROOT_DIR" -B "${PLUGIN_BUILD_DIR:-.}/build_plugin"

  cmake --build "${PLUGIN_BUILD_DIR:-.}/build_plugin"

  printf 'Run the following command to install the plugin:\n'
  printf '  sudo cmake --install %q --prefix /usr\n' "${PLUGIN_BUILD_DIR:-.}/build_plugin"
}

macos() {
  : "${PLUGIN_BUILD_DIR:=$PWD}"
  : "${VCPKG_ROOT:=${PLUGIN_BUILD_DIR:-.}/vcpkg}"

  xcbeautify() { if command -v xcbeautify >/dev/null 2>&1; then command xcbeautify; else cat; fi; }

  if [[ -z "${VCPKG_BINARY_SOURCES:-}" ]]; then
    VCPKG_BINARY_SOURCES="clear;files,${PLUGIN_BUILD_DIR:-.}/.vcpkg_archives,readwrite;http,https://vcpkg-obs.kaito.tokyo/{name}/{version}/{sha},read"
  fi

  export PLUGIN_BUILD_DIR VCPKG_ROOT VCPKG_BINARY_SOURCES

  local pwshExe cmakeExe ninjaExe
  pwshExe=$("${VCPKG_ROOT:?}/vcpkg" fetch powershell-core | tail -n1)
  cmakeExe=$("${VCPKG_ROOT:?}/vcpkg" fetch cmake | tail -n1)
  ninjaExe=$("${VCPKG_ROOT:?}/vcpkg" fetch cmake | tail -n1)

  if ! [[ -e "$cmakeExe" ]]; then
    printf 'ERROR: cmake not found.\n'; exit 1
  fi

  if ! [[ -e "$pwshExe" ]]; then
    printf 'ERROR: pwsh not found.\n'; exit 1
  fi

  PATH="${pwshExe%/*}:${cmakeExe%/*}:${ninjaExe%/*}:$PATH"
  export PATH

  printf '#==> Install vcpkg dependencies\n'

  "${VCPKG_ROOT:?}/vcpkg" install --triplet=arm64-osx-obs --x-install-root="${PLUGIN_BUILD_DIR:-.}/vcpkg_arm64_installed"
  "${VCPKG_ROOT:?}/vcpkg" install --triplet=x64-osx-obs --x-install-root="${PLUGIN_BUILD_DIR:-.}/vcpkg_x64_installed"

  ./scripts/lipo_vcpkg_macos.sh \
    "${PLUGIN_BUILD_DIR:-.}/vcpkg_installed/universal-osx-obs" \
    "${PLUGIN_BUILD_DIR:-.}/vcpkg_arm64_installed/arm64-osx-obs" \
    "${PLUGIN_BUILD_DIR:-.}/vcpkg_x64_installed/x64-osx-obs"

  printf '#==> Build OBS sources\n'

  pwsh -NoProfile -Command "Import-Module ./scripts/BuildOBS.psm1 && Invoke-ObsConfigure"
  pwsh -NoProfile -Command "Import-Module ./scripts/BuildOBS.psm1 && Invoke-ObsBuild"
  pwsh -NoProfile -Command "Import-Module ./scripts/BuildOBS.psm1 && Install-Obs"

  printf '#==> Build ONNX Runtime\n'

  export CCACHE_DIR="${PLUGIN_BUILD_DIR:-.}/.ccache_ort"
  export CCACHE_SLOPPINESS='include_file_mtime,time_macros'

  if [[ "${PLUGIN_BUILD_DIR:-.}" == "$PWD" ]]; then
    export CCACHE_BASEDIR="${PLUGIN_BUILD_DIR:-.}"
  fi

  pwsh -NoProfile -Command "Import-Module ./scripts/BuildOnnxRuntime.psm1 && Invoke-OrtBuildPy -Command update -Arch arm64"
  pwsh -NoProfile -Command "Import-Module ./scripts/BuildOnnxRuntime.psm1 && Invoke-OrtBuildPy -Command build -Arch arm64"
  pwsh -NoProfile -Command "Import-Module ./scripts/BuildOnnxRuntime.psm1 && Invoke-OrtBuildPy -Command update -Arch x86_64"
  pwsh -NoProfile -Command "Import-Module ./scripts/BuildOnnxRuntime.psm1 && Invoke-OrtBuildPy -Command build -Arch x86_64"

  unset CCACHE_DIR CCACHE_SLOPPINESS CCACHE_BASEDIR

  pwsh -NoProfile -Command "Import-Module ./scripts/BuildOnnxRuntime.psm1 && Install-Ort"

  ./scripts/lipo_vcpkg_macos.sh \
    "${PLUGIN_BUILD_DIR:-.}/vcpkg_ort_installed/universal-osx" \
    "${PLUGIN_BUILD_DIR:-.}/build_ort_arm64/Release/vcpkg_installed/arm64-osx" \
    "${PLUGIN_BUILD_DIR:-.}/build_ort_x86_64/Release/vcpkg_installed/x64-osx"

  printf '#==> Build Plugin\n'

  cmake --preset macos --config "$PLUGIN_CONFIG"
  cmake --build --preset macos --config "$PLUGIN_CONFIG" | xcbeautify

  . "${PLUGIN_BUILD_DIR:-.}/build/cmake_export.sh"

  printf 'Run the following command to install the plugin:\n'
  printf '  cmake --install "%s" --config "%s" --prefix ~\n' "${PLUGIN_BUILD_DIR:-.}/build" "$PLUGIN_CONFIG"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  set -euo pipefail
  shopt -s nullglob

  if ! [[ -f buildspec.props ]]; then
    printf 'ERROR: buildspec.props not found. The working directory MUST be the root of the project.\n' >&2
    exit 1
  fi

  [[ -f /etc/os-release ]] && . /etc/os-release
  if [[ "$(uname -s)" == Darwin ]]; then
    macos
  elif [[ "$ID" =~ ^(debian|ubuntu)$ ]] && declare -f "${ID}_$VERSION_CODENAME"; then
    "${ID}_$VERSION_CODENAME"
  elif [[ "$ID" == 'arch' ]]; then
    arch
  else
    printf 'ERROR: Your platform is not supported. Exiting...\n' >&2
    exit 1
  fi
fi
