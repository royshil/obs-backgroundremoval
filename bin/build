set -euo pipefail
shopt -s nullglob

debian_forky() {
  cmake -B "${PLUGIN_BUILD_DIR:-${PWD:?}}/build" --preset linux
  cmake --build "${PLUGIN_BUILD_DIR:-${PWD:?}}/build" --preset linux
  (cd "${PLUGIN_BUILD_DIR:-${PWD:?}}/build" && cpack -G DEB)
}

ubuntu_resolute() {
  cmake -G Ninja -S "$ROOT_DIR" -B "${PLUGIN_BUILD_DIR:-${PWD:?}}/build"

  cmake --build "${PLUGIN_BUILD_DIR:-${PWD:?}}/build"

  (cd "${PLUGIN_BUILD_DIR:-${PWD:?}}/build" && cpack -G DEB)

  . "${PLUGIN_BUILD_DIR:-${PWD:?}}/build/cmake_export.sh"

  printf 'Run the following command to install the plugin:\n'
  printf '  sudo dpkg -i %s\n' "$ROOT_DIR/release/${PLUGIN_NAME}_*.deb"
}

arch() {
  cmake -G Ninja -S "$ROOT_DIR" -B "${PLUGIN_BUILD_DIR:-${PWD:?}}/build_plugin"

  cmake --build "${PLUGIN_BUILD_DIR:-${PWD:?}}/build_plugin"

  printf 'Run the following command to install the plugin:\n'
  printf '  sudo cmake --install %q --prefix /usr\n' "${PLUGIN_BUILD_DIR:-${PWD:?}}/build_plugin"
}

macos() {
  : "${PLUGIN_BUILD_DIR:=${PWD:?}}"
  export PLUGIN_BUILD_DIR

  : "${CMAKE_OSX_DEPLOYMENT_TARGET:=12.0}"
  : "${VCPKG_BINARY_SOURCES:=clear;files,${PLUGIN_BUILD_DIR:?}/.vcpkg_archives,readwrite}"
  : "${VCPKG_ROOT:=${PLUGIN_BUILD_DIR:?}/vendor/vcpkg}"
  export CMAKE_OSX_DEPLOYMENT_TARGET VCPKG_BINARY_SOURCES VCPKG_ROOT

  if [[ "${X86_64+set}" != 'set' ]] && [[ "$(uname -m)" == 'x86_64' ]]; then
    X86_64=1
  fi
  export X86_64

  if [[ "${X86_64:-0}" == '0' ]]; then
    : "${CMAKE_OSX_ARCHITECTURES:=arm64}"
    : "${VCPKG_TARGET_TRIPLET:=arm64-osx-obs}"
    : "${VCPKG_ORT_TARGET_TRIPLET:=arm64-osx-obs-ort}"
  else
    : "${CMAKE_OSX_ARCHITECTURES:=x86_64}"
    : "${VCPKG_TARGET_TRIPLET:=x64-osx-obs}"
    : "${VCPKG_ORT_TARGET_TRIPLET:=x64-osx-obs-ort}"
  fi
  export CMAKE_OSX_ARCHITECTURES VCPKG_TARGET_TRIPLET VCPKG_ORT_TARGET_TRIPLET

  local obs_studio_git_tag
  eval "$(awk '/^obs_studio_git_tag=/ { print }' buildspec.props)"

  local onnxruntime_reduced_ops_config
  eval "$(awk '/^onnxruntime_reduced_ops_config=/ { print }' buildspec.props)"

  local ccache_macos_version
  eval "$(awk '/^ccache_macos_version=/ { print }' buildspec.props)"
  printf 'INFO: buildspec.props loaded\n' >&2

  CMAKE_COMMAND="$(PATH=/usr/bin:/bin "${VCPKG_ROOT:?}/vcpkg" fetch cmake | tail -n1)"
  export CMAKE_COMMAND
  printf "INFO: cmake found at %s\n" "${CMAKE_COMMAND:?}" >&2

  NINJA_COMMAND="$(PATH=/usr/bin:/bin "${VCPKG_ROOT:?}/vcpkg" fetch ninja | tail -n1)"
  export NINJA_COMMAND
  printf "INFO: ninja found at %s\n" "${NINJA_COMMAND:?}" >&2

  PKG_CONFIG_BINDIR="$(brew --prefix pkg-config)/bin"
  export PKG_CONFIG_BINDIR
  printf "INFO: pkg-config found at %s\n" "${PKG_CONFIG_BINDIR:?}" >&2

  export PATH="${CMAKE_COMMAND%/*}:${NINJA_COMMAND%/*}:${PKG_CONFIG_BINDIR:?}:/usr/bin:/bin"
  printf 'INFO: PATH set to %s\n' "$PATH" >&2

  "${VCPKG_ROOT:?}/vcpkg" install --triplet="${VCPKG_TARGET_TRIPLET:-arm64-osx-obs}" --x-install-root="${PLUGIN_BUILD_DIR:-${PWD:?}}/vcpkg_installed"
  printf "INFO: vcpkg dependencies were installed at %q\n" "${PLUGIN_BUILD_DIR:-${PWD:?}}/vcpkg_installed" >&2

  cmake \
    -S "${PLUGIN_BUILD_DIR:-${PWD:?}}/vendor/obs-studio" \
    -B "${PLUGIN_BUILD_DIR:-${PWD:?}}/build_obs" \
    -G "Xcode" \
    -DCMAKE_INSTALL_PREFIX="${PLUGIN_BUILD_DIR:-${PWD:?}}/obs_installed" \
    -DCMAKE_OSX_ARCHITECTURES="${CMAKE_OSX_ARCHITECTURES:?}" \
    -DCMAKE_OSX_DEPLOYMENT_TARGET="${CMAKE_OSX_DEPLOYMENT_TARGET:?}" \
    -DCMAKE_PREFIX_PATH="${PLUGIN_BUILD_DIR:-${PWD:?}}/.deps/obs-deps;${PLUGIN_BUILD_DIR:-${PWD:?}}/.deps/obs-deps-qt6" \
    -DENABLE_FRONTEND=OFF \
    -DENABLE_PLUGINS=OFF \
    -DOBS_CMAKE_VERSION=3.0.0 \
    -DOBS_VERSION_OVERRIDE="${obs_studio_git_tag:-32.0.0}"
  printf "INFO: obs-studio was configured\n" >&2

  cmake --build "${PLUGIN_BUILD_DIR:-${PWD:?}}/build_obs" --target obs-frontend-api --config Release --parallel
  printf "INFO: obs-studio was built\n" >&2

  cmake --install "${PLUGIN_BUILD_DIR:-${PWD:?}}/build_obs" --component Development --config Release --prefix "${PLUGIN_BUILD_DIR:-${PWD:?}}/obs_installed"
  printf "INFO: obs-studio was installed\n" >&2

  "${VCPKG_ROOT:?}/vcpkg" install \
    --triplet="${VCPKG_ORT_TARGET_TRIPLET:-arm64}" \
    --overlay-triplets="${PWD:?}/vcpkg-triplets" \
    --x-feature=coreml-ep \
    --x-install-root="${PLUGIN_BUILD_DIR:-${PWD:?}}/vcpkg_ort_installed" \
    --x-manifest-root="${PLUGIN_BUILD_DIR:-${PWD:?}}/vendor/onnxruntime/cmake"
  printf "INFO: vcpkg dependencies of onnxruntime were installed\n" >&2

  if [[ -n "${onnxruntime_reduced_ops_config:-}" ]] && [[ -f "${PWD:?}/${onnxruntime_reduced_ops_config:?}" ]]; then
    "${PLUGIN_BUILD_DIR:-${PWD:?}}/.venv/bin/python3" \
      "${PLUGIN_BUILD_DIR:-${PWD:?}}/vendor/onnxruntime/tools/ci_build/reduce_op_kernels.py" \
      "${PWD:?}/${onnxruntime_reduced_ops_config:?}" \
      --cmake_build_dir "${PLUGIN_BUILD_DIR:-${PWD:?}}/build_ort" \
      --is_extended_minimal_build_or_higher
    export onnxruntime_REDUCED_OPS_BUILD=ON
    printf "INFO: reduced ONNX Runtime operators were generated\n" >&2
  fi

  if [[ "${PLUGIN_BUILD_DIR:?}" == "${PWD:?}" ]]; then
    export CCACHE_BASEDIR="${PLUGIN_BUILD_DIR:?}"
  fi

  export CCACHE_DIR="${PLUGIN_BUILD_DIR:-${PWD:?}}/.ccache_ort"
  export CCACHE_SLOPPINESS='include_file_mtime,time_macros'

  cmake \
    -S "${PLUGIN_BUILD_DIR:-${PWD:?}}/vendor/onnxruntime/cmake" \
    -B "${PLUGIN_BUILD_DIR:-${PWD:?}}/build_ort" \
    -G Ninja \
    --compile-no-warning-as-error \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_C_COMPILER_LAUNCHER="${PLUGIN_BUILD_DIR:-${PWD:?}}/.deps/ccache/ccache-${ccache_macos_version:?}-darwin/ccache" \
    -DCMAKE_CXX_COMPILER_LAUNCHER="${PLUGIN_BUILD_DIR:-${PWD:?}}/.deps/ccache/ccache-${ccache_macos_version:?}-darwin/ccache" \
    -DCMAKE_OSX_ARCHITECTURES="${CMAKE_OSX_ARCHITECTURES:?}" \
    -DCMAKE_OSX_DEPLOYMENT_TARGET="${CMAKE_OSX_DEPLOYMENT_TARGET:?}" \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DCMAKE_TOOLCHAIN_FILE="${VCPKG_ROOT:?}/scripts/buildsystems/vcpkg.cmake" \
    -Donnxruntime_BUILD_SHARED_LIB=OFF \
    -Donnxruntime_BUILD_UNIT_TESTS=OFF \
    -Donnxruntime_DISABLE_RTTI=OFF \
    -Donnxruntime_REDUCED_OPS_BUILD="${onnxruntime_REDUCED_OPS_BUILD:-OFF}" \
    -Donnxruntime_RUN_ONNX_TESTS=OFF \
    -Donnxruntime_USE_COREML=ON \
    -Donnxruntime_USE_VCPKG=ON \
    -DPython_EXECUTABLE="${PLUGIN_BUILD_DIR:-${PWD:?}}/.venv/bin/python3" \
    -DVCPKG_INSTALLED_DIR="${PLUGIN_BUILD_DIR:-${PWD:?}}/vcpkg_ort_installed" \
    -DVCPKG_MANIFEST_INSTALL=OFF \
    -DVCPKG_OVERLAY_TRIPLETS="${PWD:?}/vcpkg-triplets" \
    -DVCPKG_TARGET_TRIPLET="${VCPKG_ORT_TARGET_TRIPLET:-arm64-macos-obs-ort}"
  printf "INFO: onnxruntime was configured\n" >&2

  cmake --build "${PLUGIN_BUILD_DIR:-${PWD:?}}/build_ort" --config Release --parallel
  printf "INFO: onnxruntime was built\n" >&2

  cmake --install "${PLUGIN_BUILD_DIR:-${PWD:?}}/build_ort" --prefix "${PLUGIN_BUILD_DIR:-${PWD:?}}/ort_installed"
  printf "INFO: onnxruntime was installed\n" >&2

  unset CCACHE_BASEDIR CCACHE_DIR CCACHE_SLOPPINESS

  cmake \
    -S "${PWD:?}" \
    -B "${PLUGIN_BUILD_DIR:-${PWD:?}}/build" \
    -G Ninja \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DCMAKE_OSX_ARCHITECTURES="${CMAKE_OSX_ARCHITECTURES:?}" \
    -DCMAKE_OSX_DEPLOYMENT_TARGET="${CMAKE_OSX_DEPLOYMENT_TARGET:?}" \
    -DCMAKE_PREFIX_PATH="${PLUGIN_BUILD_DIR:-${PWD:?}}/.deps/obs-deps;${PLUGIN_BUILD_DIR:-${PWD:?}}/.deps/obs-deps-qt6;${PLUGIN_BUILD_DIR:-${PWD:?}}/obs_installed;${PLUGIN_BUILD_DIR:-${PWD:?}}/obs_installed/Frameworks;${PLUGIN_BUILD_DIR:-${PWD:?}}/vcpkg_ort_installed/${VCPKG_ORT_TARGET_TRIPLET:-arm64-osx-obs-ort};${PLUGIN_BUILD_DIR:-${PWD:?}}/ort_installed;${PLUGIN_BUILD_DIR:-${PWD:?}}/vcpkg_installed/${VCPKG_TARGET_TRIPLET:-arm64-osx-obs}"
  printf "INFO: plugin was configured\n" >&2

  cmake --build "${PLUGIN_BUILD_DIR:-${PWD:?}}/build" --config RelWithDebInfo --parallel
  printf "INFO: plugin was built\n" >&2

  cmake --install "${PLUGIN_BUILD_DIR:-${PWD:?}}/build" --config RelWithDebInfo --prefix "${PLUGIN_BUILD_DIR:-${PWD:?}}/build_prefix"

  local plugin_bundle_path="${PLUGIN_BUILD_DIR:-${PWD:?}}/build_prefix/Library/Application Support/obs-studio/plugins/obs-backgroundremoval.plugin"
  if ! [[ -d "${plugin_bundle_path:?}" ]]; then
    printf "ERROR: plugin bundle was not found\n" >&2
    exit 1
  fi

  codesign -f -s - -o runtime "${plugin_bundle_path:?}"

  printf 'INFO: Run the following command to install the plugin into OBS Studio:\n' >&2
  printf "INFO: ditto --norsrc %q %q\n" "${plugin_bundle_path:?}" "$HOME/Library/Application Support/obs-studio/plugins/obs-backgroundremoval.plugin" >&2
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  set -euo pipefail
  shopt -s nullglob

  if ! [[ -f buildspec.props ]]; then
    printf 'ERROR: buildspec.props not found. The working directory MUST be the root of the project.\n' >&2
    exit 1
  fi

  [[ -f /etc/os-release ]] && . /etc/os-release
  if [[ "$(uname -s)" == Darwin ]]; then
    macos
  elif [[ "$ID" =~ ^(debian|ubuntu)$ ]] && declare -f "${ID}_$VERSION_CODENAME"; then
    "${ID}_$VERSION_CODENAME"
  elif [[ "$ID" == 'arch' ]]; then
    arch
  else
    printf 'ERROR: Your platform is not supported. Exiting...\n' >&2
    exit 1
  fi
fi
