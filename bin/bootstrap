debian_forky() {
  apt-get update
  apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    file \
    git \
    libcurl4-openssl-dev \
    libobs-dev \
    libopencv-dev \
    ninja-build \
    qt6-base-dev \
    tar \
    unzip \
    zip
}

ubuntu_resolute() {
  apt-get update
  apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    file \
    git \
    libcurl4-openssl-dev \
    libncnn-dev \
    libobs-dev \
    libopencv-dev \
    ninja-build \
    tar \
    unzip \
    zip
}

macos() {
  brew install cmake
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  set -euo pipefail
  shopt -s nullglob

  [[ -f /etc/os-release ]] && . /etc/os-release
  if [[ "$(uname -s)" == Darwin ]]; then
    macos
  elif [[ "$ID" =~ ^(debian|ubuntu)$ ]] && declare -f "${ID}_$VERSION_CODENAME" >/dev/null; then
    "${ID}_$VERSION_CODENAME"
  else
    printf 'ERROR: Your platform is not supported. Exiting...\n' >&2
    exit 1
  fi
fi
